# Copy to .env for local use. On a host (Render, Railway, ...) set these as environment variables instead.

# REQUIRED in production. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Set to production when deployed on HTTPS. Turns on Secure cookies and strict startup checks.
NODE_ENV=development

# Optional: whoever creates the very first (owner) account must type this. Strongly recommended for a new deploy.
SETUP_KEY=

# 0 = only you can create accounts (recommended for selling to clients). 1 = anyone can sign up.
ALLOW_SIGNUP=0

# Behind a host's proxy (Render, Railway, Fly, Heroku): 1. Needed for correct IPs and secure cookies.
TRUST_PROXY=

# Where the SQLite database lives. Point this at a persistent disk/volume in production.
DB_FILE=./data/rsvp.db

# Optional: your public address, used for links in the CSV export. Example: https://rsvp.yourdomain.com
PUBLIC_URL=

PORT=3000
